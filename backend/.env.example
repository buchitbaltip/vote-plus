# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
# Option A: one connection string (Neon / Supabase / Railway). TLS is enabled
# automatically when the URL contains sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Option B: local server (used only when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=vote_plus
# DB_SSL=false
# DB_LOGGING=true

# ---- Auth ----
# any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---- Blockchain (optional; leave blank to run OFF_CHAIN) ----
# Sepolia RPC. Public endpoint works; Alchemy/Infura free tier is more reliable.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of the wallet that deployed the contract (= contract owner).
BACKEND_WALLET_PRIVATE_KEY=
# Printed by `npm run deploy` in /contracts
VOTING_CONTRACT_ADDRESS=
EXPLORER_URL=https://sepolia.etherscan.io
