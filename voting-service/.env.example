# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
# Option A (default): local server. Create the database first:
#   psql -U postgres -c "CREATE DATABASE vote_plus;"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=vote_plus
DB_SSL=false
# DB_LOGGING=true
# Option B: one connection string (Neon / Supabase / Railway). If set, it
# takes precedence over DB_* above. TLS is enabled automatically when the
# URL contains sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Auth ----
# any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---- Message broker ----
# ส่งงานไปให้ blockchain-worker ผ่านคิวนี้ (ดู docker-compose.yml)
RABBITMQ_URL=amqp://vote:vote@localhost:5672

# ---- Blockchain (อ่านอย่างเดียว ไม่ใส่ก็ได้) ----
# service นี้เรียกได้แค่ view function เช่น getVotes() เพื่อเอาคะแนนมาแสดง
# private key อยู่ที่ blockchain-worker ที่เดียว ที่นี่จึงเขียนลง chain ไม่ได้
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ได้จากคำสั่ง `npm run deploy` ในโฟลเดอร์ /contracts
VOTING_CONTRACT_ADDRESS=
EXPLORER_URL=https://sepolia.etherscan.io
