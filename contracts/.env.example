# Sepolia RPC endpoint (public one works; Alchemy/Infura are more reliable)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of the wallet that deploys AND owns the contract.
# The same key goes into backend/.env as BACKEND_WALLET_PRIVATE_KEY.
# NEVER commit the real .env file.
DEPLOYER_PRIVATE_KEY=0x643B5F49Ef0d2858d7F979e77f89A21648F0fD39
CANDIDATE_COUNT=5
# Filled in after `npm run deploy`
VOTING_CONTRACT_ADDRESS=
